const { DynamoDBClient } = require("@aws-sdk/client-dynamodb");
const { DynamoDBDocumentClient, ScanCommand, GetCommand } = require("@aws-sdk/lib-dynamodb");
const readline = require("readline");

var search = require('../../routes/search');
const { Client } = require('@opensearch-project/opensearch')
const client = new Client({ node: search.getElasticSearchEndPoint() })

var REGION = "us-east-1";
var TABLE_NAME = "com.bsafes.itemVersionsV2";
var INDEX_NAME = "itemVersionsV2TimeStamp"; // GSI: partition key keyVersion, sort key createdTime

var useOpenBSafes = process.env.useOpenBSafes;
if (useOpenBSafes) {
  TABLE_NAME = "open." + TABLE_NAME;
}

var ddbClient = new DynamoDBClient({ region: REGION });
var dynamodbDoc = DynamoDBDocumentClient.from(ddbClient);

var params = {
  TableName: TABLE_NAME,
  IndexName: INDEX_NAME
};

var number = 0;

var MAX_ITEM_RETRIES = 3;
var ITEM_RETRY_DELAY_MS = 2000;

function promptToContinue(message, cb) {
  var rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  rl.question(message + " (yes/no) ", function (answer) {
    rl.close();
    cb(/^y(es)?$/i.test(String(answer).trim()));
  });
}

// Read the full item from the base table using the id (+ version) from the GSI.
function getFullItem(id, version, done) {
  dynamodbDoc.send(new GetCommand({
    TableName: TABLE_NAME,
    Key: { id: id, version: version }
  })).then(function (data) {
    done(null, data.Item);
  }).catch(function (err) {
    done(err);
  });
}

// Check whether this id/version is already in the 'itemversion' index.
function alreadyIndexed(id, version, done) {
  var indexId = id + '-' + version;
  client.exists({
    index: 'itemversion',
    id: indexId
  }).then(function (response) {
    done(null, response.body === true);
  }).catch(function (error) {
    done(error);
  });
}

// Index the full item to the 'itemversion' OpenSearch index (same shape as scanItemVersionIndex.js).
function indexItem(item, done) {
  var updatedBy = item.updatedBy ? item.updatedBy : item.owner;
  var displayName = item.displayName ? item.displayName : updatedBy;
  var indexBody = {
    id: item.id,
    version: item.version,
    space: item.space,
    createdTime: item.createdTime,
    displayName: displayName,
    updatedBy: updatedBy,
    update: item.update ? item.update : "creation",
    type: item.type,
    keyEnvelope: item.keyEnvelope,
    envelopeIV: item.envelopeIV,
    ivEnvelope: item.ivEnvelope,
    ivEnvelopeIV: item.ivEnvelopeIV,
    title: item.title
  };

  console.log(indexBody);

  var indexId = item.id + '-' + item.version;
  client.index({
    index: 'itemversion',
    id: indexId,
    body: indexBody
  }).then(function () {
    done(null);
  }).catch(function (error) {
    console.log("Could not index item: <itemversion.indexId>", indexId);
    done(error);
  });
}

// Read the full item from the base table, then index it. Retries on failure.
function processItem(gsiItem, attempt, done) {
  attempt = attempt || 1;

  alreadyIndexed(gsiItem.id, gsiItem.version, function (existsErr, exists) {
    if (existsErr) {
      return retryOrPrompt(existsErr, "Existence check for " + gsiItem.id + " v" + gsiItem.version + " failed");
    }
    if (exists) {
      console.log("Already indexed, skipping:", gsiItem.id + '-' + gsiItem.version);
      return done(null);
    }

    getFullItem(gsiItem.id, gsiItem.version, function (err, fullItem) {
      if (err) {
        return retryOrPrompt(err, "Read base table item " + gsiItem.id + " v" + gsiItem.version + " failed");
      }
      if (!fullItem) {
        console.error("Base table has no item for id:", gsiItem.id, "version:", gsiItem.version, "- skipping");
        number++;
        return done(null);
      }

      indexItem(fullItem, function (indexErr) {
        if (indexErr) {
          return retryOrPrompt(indexErr, "Index item " + gsiItem.id + " v" + gsiItem.version + " failed");
        }
        number++;
        console.log("number:", number);
        done(null);
      });
    });
  });

  function retryOrPrompt(err, label) {
    if (attempt < MAX_ITEM_RETRIES) {
      console.log(label + " (attempt " + attempt + "/" + MAX_ITEM_RETRIES + "), retrying in " + ITEM_RETRY_DELAY_MS + "ms");
      setTimeout(function () {
        processItem(gsiItem, attempt + 1, done);
      }, ITEM_RETRY_DELAY_MS);
      return;
    }
    console.error(label + " after " + MAX_ITEM_RETRIES + " attempts. Error JSON:", JSON.stringify(err, null, 2));
    promptToContinue("Retry this item? (you may raise the read capacity first) - no = skip it and continue", function (yes) {
      if (yes) {
        processItem(gsiItem, 1, done);
      } else {
        done(null);
      }
    });
  }
}

function scanIndex() {
  dynamodbDoc.send(new ScanCommand(params)).then(function (data) {
    var items = data.Items || [];
    var i = 0;

    function advance() {
      i++;
      if (i < items.length) {
        processItem(items[i], 1, advance);
      } else {
        requestForNextPage();
      }
    }

    function requestForNextPage() {
      if (data.LastEvaluatedKey) {
        console.log("===================  Next Page (count so far: " + number + ")  ===================");
        params.ExclusiveStartKey = data.LastEvaluatedKey;
        scanIndex();
      } else {
        console.log("#################### Done ########################");
        console.log("total:", number);
      }
    }

    if (items.length) {
      processItem(items[i], 1, advance);
    } else {
      requestForNextPage();
    }
  }).catch(function (err) {
    console.error("Unable to scan index. Error JSON:", JSON.stringify(err, null, 2));
    console.error("Count so far:", number);
    console.error("Last ExclusiveStartKey:", JSON.stringify(params.ExclusiveStartKey));
    promptToContinue("Retry from the last failed page? (you may raise the read capacity first)", function (yes) {
      if (yes) {
        console.log("Retrying from ExclusiveStartKey:", JSON.stringify(params.ExclusiveStartKey));
        scanIndex();
      } else {
        console.log("Aborted by user. Last ExclusiveStartKey:", JSON.stringify(params.ExclusiveStartKey));
        process.exit(1);
      }
    });
  });
}

scanIndex();
